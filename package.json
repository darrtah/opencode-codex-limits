{
  "name": "opencode-codex-limits-desktop",
  "version": "0.1.0",
  "description": "Russian-language Codex quota meter for OpenCode Desktop: reset times, account-aware caching and stale-data warnings.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darrtah/opencode-codex-limits.git"
  },
  "homepage": "https://github.com/darrtah/opencode-codex-limits#readme",
  "bugs": {
    "url": "https://github.com/darrtah/opencode-codex-limits/issues"
  },
  "private": true,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check gui-experimental.cjs && node scripts/check-package.cjs",
    "scan": "node scripts/scan-secrets.mjs"
  },
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./gui-experimental.cjs"
  },
  "files": [
    "server.ts",
    "src/entry.ts",
    "src/contract.ts",
    "src/rpc.ts",
    "src/quota-core.mjs",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md",
    "gui-experimental.cjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "solid-js": "1.9.19",
    "vite": "7.3.8",
    "vite-plugin-solid": "2.11.10"
  }
}
